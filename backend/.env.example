# CalQuity Backend Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI Configuration (optional - for real AI responses)
OPENAI_API_KEY=your_openai_api_key_here

# Redis Configuration (optional - for production queue)
REDIS_URL=redis://localhost:6379/0

# File Storage
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploaded_pdfs

# Queue Configuration
MAX_CONCURRENT_JOBS=5
NUM_WORKERS=3
